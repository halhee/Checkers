# Préconisations par agents IA (voir agents/). Copier ce fichier en .env et
# ajuster -- .env n'est jamais commité (voir .gitignore).

# Mettre à "false" pour désactiver entièrement les préconisations IA (aucun
# appel réseau, aucune dépendance crewai importée). C'est la valeur par
# défaut dans l'image Docker -- Ollama n'y est pas installé.
ENABLE_AI_RECOMMENDATIONS=true

# Modèle local (Ollama), essayé en premier pour chaque étape.
OLLAMA_MODEL=ollama/llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# Modèle cloud (Anthropic), utilisé seulement si le modèle local échoue sa
# vérification et qu'il reste du budget sous le plafond ci-dessous. Laisser
# vide pour ne jamais escalader vers le cloud.
CLOUD_MODEL=anthropic/claude-haiku-4-5-20251001
CLOUD_ANTHROPIC_API_KEY=

# Plafond de dépense cloud cumulée, en euros, suivi de façon persistante dans
# data/.cloud_spend.json (jamais réinitialisé automatiquement).
CLOUD_BUDGET_EUR=10
# Taux de change approximatif, pas un taux de change en temps réel.
USD_TO_EUR_RATE=0.92
